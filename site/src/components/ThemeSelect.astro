<nb-theme-toggle>
	<button type="button" class="nb-theme-toggle" aria-pressed="false">
		<svg class="to-dark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" />
		</svg>
		<svg class="to-light" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
		</svg>
		<span class="sr-only">Dark theme</span>
	</button>
</nb-theme-toggle>

<script>
	const storageKey = 'starlight-theme';

	// The same switch as Space Works Events: the new theme is revealed as a soft-edged circle growing
	// from the toggle where View Transitions are supported, otherwise a gentle colour cross-fade.
	// Reduced-motion users get an instant switch. The matching CSS is in styles/custom.css.
	function transitionTheme(commit: () => void, x: number, y: number) {
		const root = document.documentElement;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			commit();
			return;
		}
		if (typeof document.startViewTransition !== 'function') {
			root.classList.add('nb-theme-fade');
			commit();
			window.setTimeout(() => root.classList.remove('nb-theme-fade'), 460);
			return;
		}
		const feather = 160;
		const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) + feather;
		// The feathered edge animates a registered custom property; without it, a hard-edged clip-path.
		const feathered =
			typeof CSS.registerProperty === 'function' &&
			CSS.supports('mask-image', 'radial-gradient(circle, #000, transparent)');
		root.style.setProperty('--nb-reveal-x', `${x}px`);
		root.style.setProperty('--nb-reveal-y', `${y}px`);
		root.classList.add(feathered ? 'nb-theme-reveal-soft' : 'nb-theme-reveal');
		const cleanUp = () => {
			root.classList.remove('nb-theme-reveal', 'nb-theme-reveal-soft');
			root.style.removeProperty('--nb-reveal-x');
			root.style.removeProperty('--nb-reveal-y');
		};
		const transition = document.startViewTransition(commit);
		// Hold the final frame, or the mask snaps back for a frame and flashes the old theme.
		const timing: KeyframeAnimationOptions = {
			duration: 720,
			easing: 'cubic-bezier(0.45, 0, 0.2, 1)',
			fill: 'forwards',
			pseudoElement: '::view-transition-new(root)',
		};
		transition.ready
			.then(() => {
				root.animate(
					feathered
						? { '--nb-reveal': ['0px', `${radius}px`] }
						: { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
					timing
				);
			})
			.catch(cleanUp);
		transition.finished.finally(cleanUp);
	}

	class NbThemeToggle extends HTMLElement {
		observer?: MutationObserver;
		controller?: AbortController;

		connectedCallback() {
			this.controller = new AbortController();
			const button = this.querySelector('button')!;
			const sync = () =>
				button.setAttribute(
					'aria-pressed',
					String(document.documentElement.dataset.theme === 'dark')
				);
			sync();
			// Header and mobile-menu controls observe the same theme state.
			this.observer = new MutationObserver(sync);
			this.observer.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ['data-theme'],
			});
			button.addEventListener('click', () => {
				const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
				const box = button.getBoundingClientRect();
				transitionTheme(() => {
					document.documentElement.dataset.theme = next;
					try {
						localStorage.setItem(storageKey, next);
					} catch {}
					sync();
				}, box.left + box.width / 2, box.top + box.height / 2);
			}, { signal: this.controller.signal });
		}

		disconnectedCallback() {
			this.observer?.disconnect();
			this.controller?.abort();
		}
	}
	customElements.define('nb-theme-toggle', NbThemeToggle);
</script>

<style>
	.nb-theme-toggle {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}
	.nb-theme-toggle:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
	/* Sun and moon sit on top of each other and swap with a springy turn, as in Space Works Events. */
	.nb-theme-toggle :global(svg) {
		position: absolute;
		width: 1.1rem;
		height: 1.1rem;
		transition: transform 520ms cubic-bezier(0.34, 1.4, 0.64, 1), opacity 320ms ease-out;
	}
	:global([data-theme='light']) .to-light,
	:global([data-theme='dark']) .to-dark {
		opacity: 0;
		transform: rotate(-90deg) scale(0.5);
	}
	@media (prefers-reduced-motion: reduce) {
		.nb-theme-toggle :global(svg) {
			transition: none;
		}
	}
</style>

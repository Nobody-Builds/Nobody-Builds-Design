---
// All 17 pages of the brand guidelines, in presentation order, each opening at full size.
import { kitUrl } from './kit-url';

const pages = Array.from({ length: 17 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<div class="nb-pages not-content">
  {
    pages.map((n) => (
      <a class="nb-page" href={kitUrl(`brand/guidelines/${n}.png`)}>
        <img src={kitUrl(`brand/guidelines/${n}.png`)} alt={`Brand guidelines page ${n}`} loading="lazy" width="1440" height="1000" />
        <span>Page {n}</span>
      </a>
    ))
  }
</div>

---
// Every logo master in logo/, shown on the background it is made for, with SVG and PNG downloads.
import { kitUrl } from './kit-url';

const logos = [
  { file: 'lockup-stacked', name: 'Primary', use: 'Builder + two-line wordmark', surface: 'white' },
  { file: 'lockup-horizontal', name: 'Horizontal', use: 'Narrow headers', surface: 'butter' },
  { file: 'symbol', name: 'Symbol', use: 'Recognition at a glance', surface: 'sky' },
  { file: 'app-icon', name: 'App icon', use: 'Builder ≈ 62% of a Paper tile', surface: 'paper' },
  { file: 'lockup-stacked-reversed', name: 'Primary, reversed', use: 'Dark surfaces', surface: 'ink' },
  { file: 'lockup-horizontal-reversed', name: 'Horizontal, reversed', use: 'Dark surfaces', surface: 'ink' },
  { file: 'symbol-dark', name: 'Symbol, dark', use: 'Night Shift or Blueprint', surface: 'blueprint' },
];
---

<div class="nb-logos not-content">
  {
    logos.map((l) => (
      <figure class="nb-logo">
        <div class={`nb-logo__stage nb-surface--${l.surface}`}>
          <img src={kitUrl(`logo/${l.file}.png`)} alt={`Nobody Builds ${l.name.toLowerCase()} logo`} loading="lazy" />
        </div>
        <figcaption>
          <span>
            <strong>{l.name}</strong>
            <span class="nb-logo__use">{l.use}</span>
          </span>
          <span class="nb-logo__links">
            <a href={kitUrl(`logo/${l.file}.svg`)} download>SVG</a>
            <a href={kitUrl(`logo/${l.file}.png`)} download>PNG</a>
          </span>
        </figcaption>
      </figure>
    ))
  }
</div>

---
// The seven brand colours, read from tokens/tokens.json, with the role each one plays.
import tokens from '../assets/kit/tokens.json';

// ink: the caption is Night Shift instead of Paper.
const roles: Record<string, { name: string; role: string; ink?: boolean }> = {
  'night-shift': { name: 'Night Shift', role: 'Text · structure · depth' },
  blueprint: { name: 'Blueprint', role: 'Primary brand · actions' },
  'hard-hat': { name: 'Hard Hat', role: 'Energy · one bold moment', ink: true },
  sky: { name: 'Sky', role: 'Fresh fields · information', ink: true },
  butter: { name: 'Butter', role: 'Small highlights · ink text', ink: true },
  brick: { name: 'Brick', role: 'Warm accent · warnings', ink: true },
  paper: { name: 'Paper', role: 'Canvas · breathing room', ink: true },
};

const rgb = (hex: string) =>
  [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(', ');

const colours = Object.entries(tokens.brand).map(([key, hex]) => ({ key, hex, ...roles[key] }));
---

<div class="nb-colours not-content">
  {
    colours.map((c) => (
      <figure
        class:list={[
          'nb-colour',
          {
            'nb-colour--ink': c.ink,
            'nb-colour--paper': c.key === 'paper',
            'nb-colour--deep': c.key === 'night-shift',
          },
        ]}
        style={`background:${c.hex}`}
      >
        <figcaption>
          <strong>{c.name}</strong>
          <span class="nb-colour__hex">{c.hex}</span>
          <span class="nb-colour__rgb">RGB {rgb(c.hex)}</span>
          <span class="nb-colour__role">{c.role}</span>
        </figcaption>
      </figure>
    ))
  }
</div>
